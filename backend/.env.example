# Port for this proxy backend
PORT=3001

# OpenClaw Gateway WebSocket URL, e.g. ws://127.0.0.1:18789 (use wss:// for remote hosts).
OPENCLAW_URL=
# Shared Gateway secret used to bootstrap device pairing (set one, matching gateway.auth.mode).
# Never commit real values.
OPENCLAW_TOKEN=
OPENCLAW_PASSWORD=
# Where the backend keeps its Ed25519 device identity and issued device token (default: .openclaw-state).
OPENCLAW_STATE_DIR=
