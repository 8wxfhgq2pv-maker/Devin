# Backend port
PORT=3001

# OpenClaw Gateway WebSocket endpoint. Use wss:// for non-loopback hosts.
OPENCLAW_URL=ws://127.0.0.1:18789
OPENCLAW_TOKEN=
# Set only when the Gateway uses password authentication.
OPENCLAW_PASSWORD=

# Paired device identity and device token are stored here with owner-only file permissions.
OPENCLAW_STATE_PATH=.data/openclaw-device.json
