# Backend port
PORT=3001

# Required: set a unique password of at least 12 characters; blank intentionally so copied defaults fail closed.
WEBUI_PASSWORD=
# Required: HMAC session signing key (minimum 32 characters; generate with: openssl rand -base64 48).
WEBUI_SESSION_SECRET=
# Set true only when served over HTTPS (directly or via a trusted TLS reverse proxy).
WEBUI_SECURE_COOKIE=false
# Optional: exact public browser origin when the reverse proxy changes the upstream Host header.
# Never accept arbitrary X-Forwarded-Host values as a trusted origin.
WEBUI_PUBLIC_ORIGIN=

# OpenClaw Gateway WebSocket endpoint. Use wss:// for non-loopback hosts.
OPENCLAW_URL=ws://127.0.0.1:18789
OPENCLAW_TOKEN=
# Set only when the Gateway uses password authentication.
OPENCLAW_PASSWORD=

# Paired device identity and device token are stored here with owner-only file permissions.
OPENCLAW_STATE_PATH=.data/openclaw-device.json
